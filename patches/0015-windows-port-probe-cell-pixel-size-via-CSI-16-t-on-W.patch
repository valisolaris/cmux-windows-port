+    fn parses_csi_16t_reply_with_noise_before_and_after() {
+        assert_eq!(parse_csi_16t_reply("garbage[6;32;16tmore"), Some((16, 32)));
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn rejects_incomplete_or_zeroed_csi_16t_replies() {
+        assert_eq!(parse_csi_16t_reply(""), None);
+        assert_eq!(parse_csi_16t_reply("[6;20;"), None);
+        assert_eq!(parse_csi_16t_reply("[6;0;10t"), None);
+        assert_eq!(parse_csi_16t_reply("[6;20;0t"), None);
+    }
+
