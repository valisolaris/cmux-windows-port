     let start = response.find("\x1b[4;")?;
@@ -388,6 +382,71 @@ fn query_cell_pixels() -> Option<(u16, u16)> {
     Some((((width / cols as u32).max(1)) as u16, ((height / rows as u32).max(1)) as u16))
