+/// windows-port: `CSI 14 t` can't be used here the way Unix does — draining
+/// its reply needs `read_stdin_for`, a poll(2)-based stub that's Unix-only
+/// (see `probe_kitty_graphics`'s note). Windows Terminal instead answers
+/// `CSI 16 t` (cell size in pixels, no division by cols/rows needed), which
+/// it has supported since 1.22 alongside Sixel — real-machine-probed on WT
+/// 1.24: the reply arrives as individual `crossterm::event::Event::Key` char
+/// presses (ConPTY has no raw byte stream to poll(2) over), assembling to
+/// `[6;<height>;<width>t`. Draining via `crossterm::event::poll`/`read`
+/// works here (unlike the DA1/kitty probes) because this call site runs
+/// after alternate screen/raw mode but before the input thread starts, so
+/// there's nothing else reading stdin to race or leak into.
+#[cfg(windows)]
+fn query_cell_pixels() -> Option<(u16, u16)> {
+    let mut stdout = std::io::stdout();
+    let _ = write!(stdout, "\x1b[16t");
+    let _ = stdout.flush();
+    parse_csi_16t_reply(&drain_windows_reply(Duration::from_millis(200)))
+}
+
+/// Parses a `CSI 16 t` reply (`[6;<height>;<width>t`, ESC already stripped
+/// by `drain_windows_reply`) into `(width, height)` pixels-per-cell.
+#[cfg(windows)]
+fn parse_csi_16t_reply(response: &str) -> Option<(u16, u16)> {
+    let start = response.find("[6;")?;
+    let tail = &response[start + 3..];
+    let end = tail.find('t')?;
+    let mut parts = tail[..end].split(';');
+    let height = parts.next()?.parse::<u16>().ok()?;
+    let width = parts.next()?.parse::<u16>().ok()?;
+    (height > 0 && width > 0).then_some((width, height))
+}
+
+#[cfg(not(any(unix, windows)))]
+fn query_cell_pixels() -> Option<(u16, u16)> {
+    None
+}
+
+/// Collects `crossterm` key-press characters until `[6;...t` is complete or
+/// `timeout` elapses, for parsing a `CSI 16 t` reply. Non-character events
+/// (resize, stray key-up, etc.) seen in the same window are discarded, same
+/// tradeoff the Unix probes already make at this startup call site.
+#[cfg(windows)]
+fn drain_windows_reply(timeout: Duration) -> String {
+    let deadline = Instant::now() + timeout;
+    let mut out = String::new();
+    loop {
+        let remaining = deadline.saturating_duration_since(Instant::now());
+        if remaining.is_zero() {
+            break;
+        }
+        let Ok(true) = crossterm::event::poll(remaining) else { break };
+        let Ok(event) = crossterm::event::read() else { break };
+        if let Event::Key(key) = event
+            && key.kind == KeyEventKind::Press
+            && let KeyCode::Char(c) = key.code
+        {
+            out.push(c);
+            if c == 't' && out.contains("[6;") {
+                break;
+            }
+        }
+    }
+    out
+}
+
