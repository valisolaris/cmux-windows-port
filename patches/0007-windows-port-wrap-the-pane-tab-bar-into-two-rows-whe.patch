+/// Padded, truncated cell text for every tab's label (e.g. " 1 zsh ").
+/// Shared between rendering (`draw_tab_bar`) and layout (`pane_parts_for_rect`,
+/// via [`tab_bar_label_widths`]) so the two never disagree about where a
+/// row wraps.
+pub(crate) fn tab_bar_labels(tab_cfg: &Tabs, tabs: &[TabView]) -> Vec<String> {
+    let min_w = tab_cfg.min_width as usize;
+    tabs.iter()
+        .enumerate()
+        .map(|(i, t)| {
+            let mut raw = tab_label(tab_cfg, i, &t.title, t.name.as_deref());
+            if t.notification.is_some_and(|notification| notification.unread) {
+                raw.push_str(" •");
+            }
+            let label = format!(" {} ", truncate(&raw, 16));
+            let short = min_w.saturating_sub(label.chars().count());
+            format!("{}{}{}", " ".repeat(short / 2), label, " ".repeat(short - short / 2))
+        })
+        .collect()
+}
+
+/// Cell width of each [`tab_bar_labels`] entry, for layout code that only
+/// needs to know how much horizontal room the tab bar needs.
+pub(crate) fn tab_bar_label_widths(tab_cfg: &Tabs, tabs: &[TabView]) -> Vec<u16> {
+    tab_bar_labels(tab_cfg, tabs).iter().map(|l| l.chars().count() as u16).collect()
+}
