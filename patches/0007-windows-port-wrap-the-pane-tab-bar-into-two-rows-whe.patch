+/// How many rows the tab bar needs: 1 normally, 2 when the tabs (plus the
+/// `+` button and a possible `›` arrow) don't fit a single row and both
+/// `max_rows` and the pane's height allow growing. `PLUS_W`/`ARROW_W` match
+/// the per-tab reservation `draw_tab_bar` (via the same
+/// [`crate::ui::pane::tab_bar_label_widths`] input) uses when deciding
+/// whether every tab fits row 1 unscrolled, so bar and content never
+/// disagree on where a row wraps.
+fn tab_bar_rows(rect: Rect, tab_widths: &[u16], max_rows: u16) -> u16 {
+    if max_rows < 2 || rect.height < 5 {
+        return 1;
+    }
+    let inner_w = u32::from(rect.width.saturating_sub(2));
+    const PLUS_W: u32 = 3; // " + "
+    const ARROW_W: u32 = 1; // possible trailing "›"
+    let total: u32 = tab_widths.iter().map(|&w| u32::from(w)).sum::<u32>() + PLUS_W + ARROW_W;
+    if total > inner_w { 2 } else { 1 }
+}
