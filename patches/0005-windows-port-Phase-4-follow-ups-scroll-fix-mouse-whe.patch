+    /// Collapse the selected row if it's an expanded directory. Returns
+    /// whether it collapsed anything.
+    fn collapse_if_expanded(&mut self) -> bool {
+        let Some(row) = self.selected_row() else { return false };
+        if !row.entry.is_dir() || !row.expanded {
+            return false;
+        }
+        let path = row.entry.path.clone();
+        self.expanded.remove(&path);
+        self.navigation.pin();
+        self.rebuild_rows();
+        self.apply_filter(Some(&path));
+        true
+    }
+
