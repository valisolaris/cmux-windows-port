+    #[test]
+    fn mouse_click_on_expand_marker_toggles_directory() {
+        let temp = test_temp_dir("expand-marker-click");
+        std::fs::create_dir(temp.join("subdir")).unwrap();
+        std::fs::write(temp.join("subdir").join("inner.txt"), "x").unwrap();
+        let mux = Mux::new("expand-marker-click-test", SurfaceOptions::default());
+        mux.new_workspace(Some("work".to_string()), None).unwrap();
+        let mut app = test_app(Session::Local(mux));
+        app.replace_tree(app.session.tree());
+        // sync_layout's follow-focused-cwd side effect only reroots the
+        // sidebar to the (real, unrelated) surface cwd when unpinned; run it
+        // before installing the test's FileBrowser so it can't clobber it.
+        app.sync_layout((100, 10));
+        app.sidebar_files = FileBrowser::new(temp.clone());
+        app.sidebar_view = SidebarView::Files;
+
+        let mut terminal = Terminal::new(TestBackend::new(100, 10)).unwrap();
+        terminal.draw(|frame| crate::ui::draw(&mut app, frame)).unwrap();
+        let toggle_rect = app
+            .hits
+            .iter()
+            .find_map(|(rect, hit)| matches!(hit, super::Hit::SidebarFileToggle { .. }).then_some(*rect))
+            .expect("subdir should register an expand-marker hit");
+
+        assert!(!app.sidebar_files.visible_rows().any(|row| row.entry.name == "inner.txt"));
+
+        app.handle_mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: toggle_rect.x,
+            row: toggle_rect.y,
+            modifiers: KeyModifiers::NONE,
+        })
+        .unwrap();
+        assert!(app.sidebar_files.visible_rows().any(|row| row.entry.name == "inner.txt"));
+
+        app.handle_mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: toggle_rect.x,
+            row: toggle_rect.y,
+            modifiers: KeyModifiers::NONE,
+        })
+        .unwrap();
+        assert!(!app.sidebar_files.visible_rows().any(|row| row.entry.name == "inner.txt"));
+
+        std::fs::remove_dir_all(temp).unwrap();
+    }
