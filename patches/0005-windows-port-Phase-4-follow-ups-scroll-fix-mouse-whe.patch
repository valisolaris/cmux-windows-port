+    #[test]
+    fn mouse_wheel_scrolls_file_sidebar_selection() {
+        let temp = test_temp_dir("file-sidebar-wheel");
+        for index in 0..10 {
+            std::fs::write(temp.join(format!("file-{index:02}.txt")), "x").unwrap();
+        }
+        let mux = Mux::new("file-sidebar-wheel-test", SurfaceOptions::default());
+        mux.new_workspace(Some("work".to_string()), None).unwrap();
+        let mut app = test_app(Session::Local(mux));
+        app.replace_tree(app.session.tree());
+        // sync_layout's follow-focused-cwd side effect only reroots the
+        // sidebar to the (real, unrelated) surface cwd when unpinned; run it
+        // before installing the test's FileBrowser so it can't clobber it.
+        app.sync_layout((100, 10));
+        app.sidebar_files = FileBrowser::new(temp.clone());
+        app.sidebar_view = SidebarView::Files;
+
+        let workspace_area = app.sidebar_layout.workspace.unwrap();
+        assert_eq!(app.sidebar_files.selected(), 0);
+
+        let action = app
+            .handle_scroll(workspace_area.x + 1, workspace_area.y + 2, true, KeyModifiers::NONE)
+            .unwrap();
+        assert_eq!(action, RenderAction::Draw);
+        assert_eq!(app.sidebar_files.selected(), 3);
+
+        app.handle_scroll(workspace_area.x + 1, workspace_area.y + 2, true, KeyModifiers::NONE)
+            .unwrap();
+        assert_eq!(app.sidebar_files.selected(), 6);
+
+        app.handle_scroll(workspace_area.x + 1, workspace_area.y + 2, false, KeyModifiers::NONE)
+            .unwrap();
+        assert_eq!(app.sidebar_files.selected(), 3);
+
+        std::fs::remove_dir_all(temp).unwrap();
+    }
