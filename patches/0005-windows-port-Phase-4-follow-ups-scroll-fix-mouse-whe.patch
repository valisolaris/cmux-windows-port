+    #[test]
+    fn double_click_on_file_row_activates_it_but_a_single_click_does_not() {
+        let temp = test_temp_dir("file-double-click");
+        std::fs::write(temp.join("note.txt"), "x").unwrap();
+        let mux = Mux::new("file-double-click-test", SurfaceOptions::default());
+        mux.new_workspace(Some("work".to_string()), None).unwrap();
+        let mut app = test_app(Session::Local(mux));
+        app.replace_tree(app.session.tree());
+        // sync_layout's follow-focused-cwd side effect only reroots the
+        // sidebar to the (real, unrelated) surface cwd when unpinned; run it
+        // before installing the test's FileBrowser so it can't clobber it.
+        app.sync_layout((100, 10));
+        app.sidebar_files = FileBrowser::new(temp.clone());
+        app.sidebar_view = SidebarView::Files;
+
+        let mut terminal = Terminal::new(TestBackend::new(100, 10)).unwrap();
+        terminal.draw(|frame| crate::ui::draw(&mut app, frame)).unwrap();
+        let row_rect = app
+            .hits
+            .iter()
+            .find_map(|(rect, hit)| {
+                matches!(hit, super::Hit::SidebarFile { index: 0 }).then_some(*rect)
+            })
+            .expect("note.txt should be hit-testable");
+
+        assert!(app.sidebar_files.message().is_none());
+
+        app.handle_mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: row_rect.x + 2,
+            row: row_rect.y,
+            modifiers: KeyModifiers::NONE,
+        })
+        .unwrap();
+        assert!(app.sidebar_files.message().is_none(), "a single click must not activate the row");
+
+        app.handle_mouse(MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: row_rect.x + 2,
+            row: row_rect.y,
+            modifiers: KeyModifiers::NONE,
+        })
+        .unwrap();
+        assert!(
+            app.sidebar_files.message().is_some(),
+            "a second click within the double-click window must activate the row"
+        );
+
+        std::fs::remove_dir_all(temp).unwrap();
+    }
