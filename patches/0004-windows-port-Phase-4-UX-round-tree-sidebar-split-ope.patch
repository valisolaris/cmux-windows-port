+    /// Bring `pane`'s tab at `tab_index` into view, switching workspace
+    /// and/or screen first if it isn't in the currently active one. Used by
+    /// the sessions sidebar: selecting any pane/tab anywhere should focus it
+    /// for real, not just highlight a row that's off screen.
+    fn focus_pane_tab_anywhere(&mut self, pane: PaneId, tab_index: Option<usize>) {
+        let Some((workspace_index, screen_index)) =
+            self.tree.workspaces.iter().enumerate().find_map(|(wi, workspace)| {
+                workspace
+                    .screens
+                    .iter()
+                    .position(|screen| screen.panes.iter().any(|candidate| candidate.id == pane))
+                    .map(|si| (wi, si))
+            })
+        else {
+            return;
+        };
+        if workspace_index != self.tree.active_workspace {
+            self.select_workspace_for_client(Some(workspace_index), None);
+        }
+        let already_active_screen = self
+            .tree
+            .workspaces
+            .get(workspace_index)
+            .is_some_and(|workspace| workspace.active_screen == screen_index);
+        if !already_active_screen {
+            self.select_screen_for_client(Some(screen_index), None);
+        }
+        self.focus_pane_after_input(pane);
+        self.select_tab_for_client(Some(pane), tab_index, None);
