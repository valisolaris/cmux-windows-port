+/// How long to wait, after one pasteable keystroke, for the next one before
+/// giving up and treating it as an ordinary single keypress.
+///
+/// windows-port: crossterm's Windows event source never emits
+/// `Event::Paste` (`ReadConsoleInputW` is turned into `Event::Key` one
+/// character at a time, unlike the Unix source which parses bracketed-paste
+/// escapes) — see `ui/graphics.rs`'s `probe_kitty_graphics` doc for the
+/// same crossterm-Windows-source class of limitation. So a paste like
+/// `/copy`'s clipboard text arrives here as a burst of individual key
+/// events, including `Enter` for every embedded newline, and each of those
+/// would otherwise submit whatever's typed so far. `read_input_batch`
+/// coalesces a fast burst of such keys back into a single `Event::Paste`,
+/// which the existing (already-correct) bracketed-paste handling in
+/// `paste`/`paste_sidebar` then wraps and sends as one write. A human typing
+/// has keystroke intervals in the tens of milliseconds at the very fastest;
+/// this window is comfortably below that so ordinary typing is unaffected.
+const PASTE_BURST_GAP: Duration = Duration::from_millis(4);
+
+/// A key that could plausibly be one character of a pasted string: a plain
+/// (optionally shifted) printable character, or Enter for an embedded
+/// newline. Anything else (control chords, arrows, function keys, key-up
+/// events) ends a burst immediately.
+fn pasteable_char(key: &KeyEvent) -> Option<char> {
+    if key.kind != KeyEventKind::Press {
+        return None;
+    }
+    match key.code {
+        KeyCode::Char(c) if key.modifiers.difference(KeyModifiers::SHIFT).is_empty() => Some(c),
+        KeyCode::Enter if key.modifiers.is_empty() => Some('\n'),
+        _ => None,
+    }
+}
+
+/// Reads one crossterm event, then — if it's a pasteable key — keeps
+/// reading with a short timeout for as long as pasteable keys keep arriving
+/// within `PASTE_BURST_GAP` of each other. A burst of 2+ keys collapses to
+/// a single `Event::Paste`; a lone key (normal typing) is returned as the
+/// `Event::Key` crossterm gave it, unchanged.
+fn read_input_batch() -> std::io::Result<Vec<Event>> {
+    let first = crossterm::event::read()?;
+    let Event::Key(first_key) = first else {
+        return Ok(vec![first]);
+    };
+    if pasteable_char(&first_key).is_none() {
+        return Ok(vec![Event::Key(first_key)]);
+    }
+    let mut burst = vec![first_key];
+    loop {
+        if !crossterm::event::poll(PASTE_BURST_GAP)? {
+            return Ok(finish_paste_burst(burst, None));
+        }
+        match crossterm::event::read()? {
+            Event::Key(key) if pasteable_char(&key).is_some() => burst.push(key),
+            other => return Ok(finish_paste_burst(burst, Some(other))),
+        }
+    }
+}
+
+fn finish_paste_burst(burst: Vec<KeyEvent>, trailing: Option<Event>) -> Vec<Event> {
+    let mut out = Vec::with_capacity(2);
+    if let [only] = burst.as_slice() {
+        out.push(Event::Key(*only));
+    } else {
+        out.push(Event::Paste(burst.iter().filter_map(pasteable_char).collect()));
+    }
+    out.extend(trailing);
+    out
+}
