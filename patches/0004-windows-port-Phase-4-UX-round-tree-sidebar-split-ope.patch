+                mask[x as usize] |= 1 << row;
+            }
+        }
+        let mut colors = color_masks.keys().copied().collect::<Vec<_>>();
+        colors.sort_unstable();
+        for (color_rank, color) in colors.iter().enumerate() {
+            if color_rank > 0 {
+                out.push(b'$');
+            }
+            out.extend_from_slice(format!("#{color}").as_bytes());
+            let masks = &color_masks[color];
+            let mut col = 0;
+            while col < masks.len() {
+                let mask = masks[col];
+                let mut count = 1;
+                while col + count < masks.len() && masks[col + count] == mask {
+                    count += 1;
+                }
+                let ch = 0x3F + mask;
+                if count >= 4 {
+                    out.extend_from_slice(format!("!{count}").as_bytes());
+                    out.push(ch);
+                } else {
+                    for _ in 0..count {
+                        out.push(ch);
+                    }
+                }
+                col += count;
+            }
+        }
+        out.push(b'-');
+        band_start += band_height;
+    }
+    out.extend_from_slice(b"\x1b\\");
+    out
+}
