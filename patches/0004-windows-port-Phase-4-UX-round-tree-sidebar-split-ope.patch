+/// One row of the sessions sidebar's flattened pane/tab list. Shared with
+/// `app.rs` so keyboard navigation and mouse clicks walk the exact same
+/// list the renderer drew.
+pub(crate) struct SessionRow {
+    pub pane: PaneId,
+    pub tab_index: usize,
+    pub name: String,
+    pub subtitle: String,
+    pub active: bool,
+}
+
+pub(crate) fn session_rows(app: &App) -> Vec<SessionRow> {
+    let mut rows = Vec::new();
+    for workspace in &app.tree.workspaces {
+        for (screen_index, screen) in workspace.screens.iter().enumerate() {
+            for pane in &screen.panes {
+                for (tab_index, tab) in pane.tabs.iter().enumerate() {
+                    let title = if tab.title.is_empty() { "shell" } else { tab.title.as_str() };
+                    let active = pane.id == screen.active_pane && tab_index == pane.active_tab;
+                    rows.push(SessionRow {
+                        pane: pane.id,
+                        tab_index,
+                        name: title.to_string(),
+                        subtitle: format!(
+                            "{} / {}",
+                            workspace.name,
+                            screen.display_name(screen_index)
+                        ),
+                        active,
+                    });
+                }
+            }
+        }
+    }
+    rows
+}
+
+fn draw_sessions(app: &mut App, frame: &mut Frame) {
+    let Some(area) = app.workspace_sidebar_area(frame.area().height) else { return };
+    let palette = rail::RailPalette::for_app(app, app.workspace_sidebar_focused());
+    let messages = &localization::catalog().sidebar;
+    rail::prepare(frame, area, palette);
+    rail::header(frame, area, messages.sessions, palette);
+
+    let rows = session_rows(app);
+    app.sidebar_session_selection = app.sidebar_session_selection.min(rows.len().saturating_sub(1));
+    let body_rows = rows.len() * rail::ENTRY_STRIDE;
+    let selected_body = app.workspace_sidebar_focused().then(|| {
+        rail::RowSpan::new(app.sidebar_session_selection * rail::ENTRY_STRIDE, rail::ENTRY_HEIGHT)
+    });
+    let mut footer_scroll = 0;
+    let viewport = rail::viewport(
+        area,
+        body_rows,
+        0,
+        &mut app.sidebar_session_scroll,
+        &mut footer_scroll,
+        selected_body,
+        None,
+    );
+
+    let mut hits = Vec::new();
+    if rows.is_empty() {
+        if let Some(y) = viewport.body_y(rail::RowSpan::new(0, 1)) {
+            frame.buffer_mut().set_stringn(
+                area.x,
+                y,
+                " No sessions",
+                area.width.saturating_sub(1) as usize,
+                palette.dim,
+            );
+        }
+    }
+    for (i, row) in rows.iter().enumerate() {
+        let span = rail::RowSpan::new(i * rail::ENTRY_STRIDE, rail::ENTRY_HEIGHT);
+        let Some(y) = viewport.body_y(span) else { continue };
+        let highlighted = app.workspace_sidebar_focused() && i == app.sidebar_session_selection;
+        rail::entry(
+            frame,
+            area,
+            y,
+            rail::Entry {
+                name: &row.name,
+                subtitle: &row.subtitle,
+                highlighted,
+                active: row.active,
+                indicator: None,
+                dimmed: false,
+            },
+            palette,
+        );
+        hits.push((rail::row(area, y), Hit::SessionTab { pane: row.pane, tab_index: row.tab_index }));
+        hits.push((
+            rail::row(area, y + 1),
+            Hit::SessionTab { pane: row.pane, tab_index: row.tab_index },
+        ));
+    }
+    hits.push((rail::divider(area), Hit::RailResize(RailKind::Workspace)));
+    app.hits.extend(hits);
+}
