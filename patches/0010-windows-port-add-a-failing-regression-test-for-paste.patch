+    #[test]
+    fn classify_burst_event_pushes_pasteable_keys() {
+        let key = KeyEvent::new(KeyCode::Char('a'), KeyModifiers::NONE);
+        assert_eq!(classify_burst_event(Event::Key(key)), BurstEvent::Push(key));
+    }
+
+    #[test]
+    fn classify_burst_event_ignores_key_release_windows_port() {
+        let mut release = KeyEvent::new(KeyCode::Char('a'), KeyModifiers::NONE);
+        release.kind = crossterm::event::KeyEventKind::Release;
+        assert_eq!(classify_burst_event(Event::Key(release)), BurstEvent::Ignore);
+    }
+
+    #[test]
+    fn classify_burst_event_ends_burst_on_non_pasteable_key() {
+        let arrow = KeyEvent::new(KeyCode::Up, KeyModifiers::NONE);
+        assert_eq!(
+            classify_burst_event(Event::Key(arrow)),
+            BurstEvent::End(Some(Event::Key(arrow)))
+        );
+    }
+
+    /// windows-port regression test: simulates the Press/Release-interleaved
+    /// event stream crossterm's Windows source produces for a clipboard
+    /// paste (see `BurstEvent::Ignore`'s doc comment). Before that arm
+    /// existed, the release right after the first pasted character ended
+    /// the burst after just one key, so a paste never coalesced into a
+    /// single `Event::Paste` and an embedded Enter would have reached the
+    /// shell as a literal, premature submit.
+    #[test]
+    fn windows_paste_burst_survives_interleaved_key_releases() {
+        fn press(code: KeyCode) -> KeyEvent {
+            KeyEvent::new(code, KeyModifiers::NONE)
+        }
+        fn release(code: KeyCode) -> KeyEvent {
+            let mut key = press(code);
+            key.kind = crossterm::event::KeyEventKind::Release;
+            key
+        }
+
+        let stream = [
+            press(KeyCode::Char('a')),
+            release(KeyCode::Char('a')),
+            press(KeyCode::Char('b')),
+            release(KeyCode::Char('b')),
+            press(KeyCode::Char('c')),
+            release(KeyCode::Char('c')),
+            press(KeyCode::Enter),
+            release(KeyCode::Enter),
+        ];
+
+        // Mirrors read_input_batch's own loop: the first event starts the
+        // burst unconditionally, then every later event is folded through
+        // classify_burst_event exactly as read_input_batch does.
+        let mut events = stream.into_iter();
+        let mut burst = vec![events.next().unwrap()];
+        let mut trailing = None;
+        for event in events {
+            match classify_burst_event(Event::Key(event)) {
+                BurstEvent::Push(key) => burst.push(key),
+                BurstEvent::Ignore => continue,
+                BurstEvent::End(t) => {
+                    trailing = t;
+                    break;
+                }
+            }
+        }
+
+        assert_eq!(
+            finish_paste_burst(burst, trailing),
+            vec![Event::Paste("abc\n".to_string())]
+        );
+    }
