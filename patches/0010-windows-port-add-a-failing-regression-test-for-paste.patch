+/// What a single event, seen while a paste burst is in progress, means for
+/// that burst. Split out from `read_input_batch` so the decision is a pure
+/// function tests can drive directly.
+#[derive(Debug, PartialEq)]
+enum BurstEvent {
+    /// A pasteable key: fold it into the burst and keep reading.
+    Push(KeyEvent),
+    /// windows-port: crossterm's Windows source emits a matching
+    /// `KeyEventKind::Release` for every `Press` — real keystrokes and
+    /// clipboard-injected paste characters alike (`handle_key` already
+    /// no-ops on `Release`, see there). Ignoring it here, instead of ending
+    /// the burst, is what lets consecutive pasted characters keep
+    /// coalescing: without this arm, the release right after the very
+    /// first pasted character ended the burst after one key, so
+    /// paste-burst coalescing never engaged and an embedded Enter mid-paste
+    /// hit the shell as a literal, premature submit.
+    Ignore,
+    /// Anything else ends the burst; carries the event along as trailing
+    /// input if there was one.
+    End(Option<Event>),
+}
+
+fn classify_burst_event(event: Event) -> BurstEvent {
+    match event {
+        Event::Key(key) if pasteable_char(&key).is_some() => BurstEvent::Push(key),
+        other => BurstEvent::End(Some(other)),
+    }
+}
+
 /// Reads one crossterm event, then — if it's a pasteable key — keeps
-/// reading with a short timeout for as long as pasteable keys keep arriving
-/// within `PASTE_BURST_GAP` of each other. A burst of 2+ keys collapses to
-/// a single `Event::Paste`; a lone key (normal typing) is returned as the
-/// `Event::Key` crossterm gave it, unchanged.
+/// reading with a short timeout for as long as pasteable keys (and their
+/// releases) keep arriving within `PASTE_BURST_GAP` of each other. A burst
+/// of 2+ keys collapses to a single `Event::Paste`; a lone key (normal
+/// typing) is returned as the `Event::Key` crossterm gave it, unchanged.
 fn read_input_batch() -> std::io::Result<Vec<Event>> {
     let first = crossterm::event::read()?;
     let Event::Key(first_key) = first else {
@@ -2083,9 +2112,10 @@ fn read_input_batch() -> std::io::Result<Vec<Event>> {
         if !crossterm::event::poll(PASTE_BURST_GAP)? {
             return Ok(finish_paste_burst(burst, None));
         }
-        match crossterm::event::read()? {
-            Event::Key(key) if pasteable_char(&key).is_some() => burst.push(key),
-            other => return Ok(finish_paste_burst(burst, Some(other))),
+        match classify_burst_event(crossterm::event::read()?) {
