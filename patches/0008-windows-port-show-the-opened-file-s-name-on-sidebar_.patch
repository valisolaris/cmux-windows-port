From 842e75221e81aff9dde608634c582dfa73a1d2e4 Mon Sep 17 00:00:00 2001
From: valisolaris <valisolaris@gmail.com>
Date: Sun, 26 Jul 2026 18:51:42 +0900
Subject: [PATCH] windows-port: show the opened file's name on sidebar_files
 editor tabs

sidebar_files' "open in a new pane" path threads a name through
Mux::split_with_command / Session::split_with_command /
App::split_with_command (mirroring the existing RunCommandOptions.name
pattern) so a tab opened via FileCommand::OpenEditor gets
Surface::set_name(path.file_name()) right away instead of staying a
bare number. tab_label() already prefers a non-empty name, so no
rendering changes were needed there. Manual RenameTab still overrides
it afterwards, and same-named files opened from different directories
are intentionally left undistinguished (use RenameTab).

Also replaces the hardcoded 16-character tab label truncation with the
new tabs.max_width setting (default 24), independent of the existing
min_width padding setting.
---
 cmux-tui/crates/cmux-tui-core/src/mux.rs    |  4 ++
 cmux-tui/crates/cmux-tui/src/app.rs         |  5 ++-
 cmux-tui/crates/cmux-tui/src/config.rs      | 45 +++++++++++++++++++--
 cmux-tui/crates/cmux-tui/src/session/mod.rs |  7 ++--
 cmux-tui/crates/cmux-tui/src/ui/pane.rs     | 35 +++++++++++++++-
 5 files changed, 87 insertions(+), 9 deletions(-)

diff --git a/cmux-tui/crates/cmux-tui-core/src/mux.rs b/cmux-tui/crates/cmux-tui-core/src/mux.rs
index 3e3ac23ebd..a41c31a1a5 100644
--- a/cmux-tui/crates/cmux-tui-core/src/mux.rs
+++ b/cmux-tui/crates/cmux-tui-core/src/mux.rs
@@ -3275,10 +3275,14 @@ impl Mux {
         dir: SplitDir,
         argv: Vec<String>,
         cwd: Option<String>,
+        name: Option<String>,
         size: Option<(u16, u16)>,
     ) -> anyhow::Result<Arc<Surface>> {
         let cwd = cwd.or_else(|| self.pane_cwd(target));
         let surface = self.spawn_surface_with_command(cwd, size, Some(argv))?;
+        if let Some(name) = name {
+            surface.set_name(Some(name));
+        }
         self.split_with_surface(target, dir, surface)
     }
 
diff --git a/cmux-tui/crates/cmux-tui/src/app.rs b/cmux-tui/crates/cmux-tui/src/app.rs
index 790bcbb456..402d993155 100644
--- a/cmux-tui/crates/cmux-tui/src/app.rs
+++ b/cmux-tui/crates/cmux-tui/src/app.rs
@@ -1850,10 +1850,11 @@ impl OrderedSession {
         dir: SplitDir,
         argv: Vec<String>,
         cwd: Option<String>,
+        name: Option<String>,
         size: Option<(u16, u16)>,
     ) -> anyhow::Result<()> {
         self.enqueue_with_completion("split pane with command", true, move |session| {
-            let surface = session.split_with_command(pane, dir, argv, cwd, size)?;
+            let surface = session.split_with_command(pane, dir, argv, cwd, name, size)?;
             Ok(Some(SessionCompletionAction::SurfaceCreated { surface }))
         });
         Ok(())
@@ -7230,11 +7231,13 @@ impl App {
                 if !self.prepare_pty_input_before_mutation() {
                     return;
                 }
+                let name = path.file_name().map(|n| n.to_string_lossy().into_owned());
                 self.session.split_with_command(
                     pane,
                     SplitDir::Right,
                     vec![editor, path.to_string_lossy().into_owned()],
                     Some(cwd),
+                    name,
                     hint,
                 )
             }
diff --git a/cmux-tui/crates/cmux-tui/src/config.rs b/cmux-tui/crates/cmux-tui/src/config.rs
index 419e452859..6b78192669 100644
--- a/cmux-tui/crates/cmux-tui/src/config.rs
+++ b/cmux-tui/crates/cmux-tui/src/config.rs
@@ -406,6 +406,7 @@ pub fn is_light_background(bg: Rgb) -> bool {
 #[serde(deny_unknown_fields)]
 struct RawTabs {
     min_width: Option<u16>,
+    max_width: Option<u16>,
     max_rows: Option<u16>,
     solid_background: Option<bool>,
     show_titles: Option<bool>,
@@ -643,10 +644,14 @@ impl Default for Theme {
 /// Tab-bar behavior.
 #[derive(Debug, Clone)]
 pub struct Tabs {
-    /// Minimum label width in cells (padded with spaces).
+    /// Label's minimum width (padding) in cells.
     pub min_width: u16,
-    /// Maximum number of tab bar rows when tabs overflow the pane width.
-    /// Valid values are 1 or 2; out-of-range values are clamped (<=0 -> 1, >=3 -> 2).
+    /// A single tab label's maximum length in characters, before truncating
+    /// with an ellipsis.
+    pub max_width: u16,
+    /// The tab bar's maximum number of rows when tabs overflow the pane
+    /// width. Valid values are 1 or 2; out-of-range values are clamped
+    /// (<=0 -> 1, >=3 -> 2).
     pub max_rows: u16,
     /// Tabs render with a solid background instead of text on the border.
     pub solid_background: bool,
@@ -662,6 +667,7 @@ impl Default for Tabs {
     fn default() -> Self {
         Tabs {
             min_width: 7,
+            max_width: 24,
             max_rows: 2,
             solid_background: true,
             show_titles: false,
@@ -1342,6 +1348,9 @@ pub fn load() -> Config {
     if let Some(w) = raw.tabs.min_width {
         config.tabs.min_width = w.clamp(3, 40);
     }
+    if let Some(w) = raw.tabs.max_width {
+        config.tabs.max_width = w;
+    }
     if let Some(r) = raw.tabs.max_rows {
         config.tabs.max_rows = r.clamp(1, 2);
     }
@@ -2319,6 +2328,16 @@ mod tests {
         assert_eq!(tab_label(&titled, 1, "zsh", None), "1 zsh");
     }
 
+    #[test]
+    fn tab_label_prioritizes_a_file_name_set_by_opening_a_file() {
+        let tabs = Tabs::default();
+        // A name set from sidebar_files (e.g. opening main.rs) wins over
+        // both the numbered fallback and show_titles.
+        assert_eq!(tab_label(&tabs, 2, "vim main.rs", Some("main.rs")), "main.rs");
+        let titled = Tabs { show_titles: true, ..Tabs::default() };
+        assert_eq!(tab_label(&titled, 2, "vim main.rs", Some("main.rs")), "main.rs");
+    }
+
     #[test]
     fn tab_selection_actions_use_zero_based_indexes() {
         assert_eq!(Action::SelectTab(0).tab_index(), Some(0));
@@ -2489,6 +2508,26 @@ mod tests {
         let _ = std::fs::remove_dir_all(&dir);
     }
 
+    #[test]
+    fn tabs_max_width_default_is_24_and_config_overrides_it() {
+        assert_eq!(Tabs::default().max_width, 24);
+
+        let _guard = CONFIG_ENV_LOCK.lock().unwrap();
+        let dir = std::env::temp_dir()
+            .join(format!("mux-config-test-max-width-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("mux.json");
+
+        std::fs::write(&path, r#"{"tabs": {"max_width": 40}}"#).unwrap();
+        // SAFETY: env mutation in tests is serialized by CONFIG_ENV_LOCK.
+        unsafe { std::env::set_var("CMUX_MUX_CONFIG", &path) };
+        assert_eq!(load().tabs.max_width, 40);
+
+        // SAFETY: env mutation in tests is serialized by CONFIG_ENV_LOCK.
+        unsafe { std::env::remove_var("CMUX_MUX_CONFIG") };
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
     #[test]
     fn browser_mode_defaults_headful_parses_headless_and_rejects_invalid_values() {
         let raw: RawConfig = serde_json::from_str(r##"{}"##).unwrap();
diff --git a/cmux-tui/crates/cmux-tui/src/session/mod.rs b/cmux-tui/crates/cmux-tui/src/session/mod.rs
index aa65096be8..d70cb790f2 100644
--- a/cmux-tui/crates/cmux-tui/src/session/mod.rs
+++ b/cmux-tui/crates/cmux-tui/src/session/mod.rs
@@ -717,12 +717,13 @@ impl Session {
         dir: SplitDir,
         argv: Vec<String>,
         cwd: Option<String>,
+        name: Option<String>,
         size: Option<(u16, u16)>,
     ) -> anyhow::Result<SurfaceId> {
         match self {
-            Session::Local(mux) => {
-                mux.split_with_command(pane, dir, argv, cwd, size).map(|surface| surface.id)
-            }
+            Session::Local(mux) => mux
+                .split_with_command(pane, dir, argv, cwd, name, size)
+                .map(|surface| surface.id),
             Session::Remote(_) => {
                 anyhow::bail!("opening files in a new pane is not supported over attach yet")
             }
diff --git a/cmux-tui/crates/cmux-tui/src/ui/pane.rs b/cmux-tui/crates/cmux-tui/src/ui/pane.rs
index c7c4cc298c..fac9ce4509 100644
--- a/cmux-tui/crates/cmux-tui/src/ui/pane.rs
+++ b/cmux-tui/crates/cmux-tui/src/ui/pane.rs
@@ -168,6 +168,7 @@ fn draw_box(app: &mut App, frame: &mut Frame, area: &PaneArea, focused: bool) {
 /// row wraps.
 pub(crate) fn tab_bar_labels(tab_cfg: &Tabs, tabs: &[TabView]) -> Vec<String> {
     let min_w = tab_cfg.min_width as usize;
+    let max_w = tab_cfg.max_width as usize;
     tabs.iter()
         .enumerate()
         .map(|(i, t)| {
@@ -175,7 +176,7 @@ pub(crate) fn tab_bar_labels(tab_cfg: &Tabs, tabs: &[TabView]) -> Vec<String> {
             if t.notification.is_some_and(|notification| notification.unread) {
                 raw.push_str(" •");
             }
-            let label = format!(" {} ", truncate(&raw, 16));
+            let label = format!(" {} ", truncate(&raw, max_w));
             let short = min_w.saturating_sub(label.chars().count());
             format!("{}{}{}", " ".repeat(short / 2), label, " ".repeat(short - short / 2))
         })
@@ -656,7 +657,11 @@ fn push_resize_hits(app: &mut App, area: &PaneArea) {
 
 #[cfg(test)]
 mod tests {
-    use super::client_border_labels;
+    use cmux_tui_core::SurfaceKind;
+
+    use super::{client_border_labels, tab_bar_labels};
+    use crate::config::Tabs;
+    use crate::session::tree::TabView;
     use crate::session::{ClientInfo, ClientSizeInfo};
 
     fn client(id: u64, surface: u64, size: Option<(u16, u16)>) -> ClientInfo {
@@ -710,4 +715,30 @@ mod tests {
         let clients = vec![client(1, 9, Some((120, 30))), client(2, 10, Some((80, 40)))];
         assert_eq!(client_border_labels(&clients).get(&9), None);
     }
+
+    fn named_tab(name: &str) -> TabView {
+        TabView {
+            surface: 0,
+            short_id: "0".to_string(),
+            name: Some(name.to_string()),
+            title: String::new(),
+            kind: SurfaceKind::Pty,
+            browser_source: None,
+            browser_frames_stalled: false,
+            notification: None,
+        }
+    }
+
+    #[test]
+    fn tab_bar_labels_truncate_to_the_configured_max_width() {
+        let cfg = Tabs { min_width: 0, max_width: 10, ..Tabs::default() };
+
+        // Exactly max_width: no truncation.
+        let exact = [named_tab("0123456789")];
+        assert_eq!(tab_bar_labels(&cfg, &exact), vec![" 0123456789 ".to_string()]);
+
+        // One over max_width: truncated with an ellipsis, filling max_width.
+        let over = [named_tab("0123456789X")];
+        assert_eq!(tab_bar_labels(&cfg, &over), vec![" 012345678… ".to_string()]);
+    }
 }
